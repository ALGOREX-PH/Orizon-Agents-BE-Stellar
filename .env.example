# ─────────────────────────────────────────────────────────────
# Orizon Agents — Backend env (FastAPI + Agno + OpenAI + Stellar)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill OPENAI_API_KEY. Everything else has
# sensible defaults for local dev.

# ── OpenAI (required) ─────────────────────────────────────────
OPENAI_API_KEY=sk-...
ORCHESTRATOR_MODEL=gpt-5.3-codex
WORKER_MODEL=gpt-5.3-codex
# Code-worker tuning (optional).
CODE_REASONING_EFFORT=high
CODE_TEMPERATURE=0.3

# ── API hardening (optional) ─────────────────────────────────
# When set, /api/stellar/server/* require a matching X-API-Key header.
API_KEY=
# Per-client-IP request budget (sliding 60s window).
RATE_LIMIT_PER_MINUTE=120
# Server-side ceiling for a single PaymentEscrow.charge, in USDC.
MAX_CHARGE_USDC=100

# ── Reputation (Bayesian smoothing + routing floor) ──────────
# Master switch for on-chain rep reads + settler rating submission.
REPUTATION_ENABLED=true
# Prior mean, in bps of the 0–100 rating scale (7000 = a 3.5/5 score).
REPUTATION_PRIOR_BPS=7000
# Evidence mass of the prior, in USDC of settled work.
REPUTATION_PRIOR_WEIGHT_USDC=12
# Routing floor applied to the smoothed lower bound at decompose time.
REPUTATION_FLOOR_BPS=5500
# TTL for cached on-chain rep_state reads (per agent), in seconds.
REPUTATION_READ_TTL_SECONDS=15
# Per-rating weight cap in USDC — one whale job can't own the score.
REPUTATION_MAX_RATING_WEIGHT_USDC=100

# ── HTTP server ──────────────────────────────────────────────
# Comma-separated. In prod, set to your Vercel URL.
CORS_ORIGINS=http://localhost:3000
# Render/Fly/Cloud Run inject $PORT at runtime. Leave 8000 for local.
PORT=8000

# ── Stellar (testnet) ────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Public contract IDs from the testnet deploy (safe to commit).
STELLAR_AGENT_REGISTRY=CAPHXWU53UZUZJGV7IAE57NNMH3YYB5MTWO6YA53KKMXSFVLOITBJ3GQ
STELLAR_REPUTATION_LEDGER=CDCSOBEVZUPQZV5GV4D6KYHZCLNGW2KXY74RUHSZ3EZUXF34DPW422ZT
STELLAR_PAYMENT_ESCROW=CBJPTMAPMGODGZCZ2IMEQSRUX3WGUXNMKDTNN2KMJ3NFGYZ5OJ5525PI
STELLAR_ATTESTATION_REGISTRY=CBYUZKOET43UXTBXZUJIBBJW5ODGD2J2AZVVXCR3QONGOCAHOXQQHEGK
STELLAR_ASSET_SAC=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Backend's signing identity. In prod, set STELLAR_SIGNING_KEY
# (S... secret) via host secrets — NEVER commit.
STELLAR_ADMIN_ADDRESS=GA7AI5TAJEZA27I666DSJC4MUJYBEWUYNNZWPU7R2ONA7IZQVO6R5OQV
STELLAR_SIGNING_KEY=

# ── PDAX (PHP ↔ crypto on/off-ramp, institutions API) ────────
# Environment: production | stage | uat. Base URL is resolved in
# app/pdax/config.py. Staging requires your static IP be whitelisted.
PDAX_ENVIRONMENT=uat
# Account credentials — inject via host secrets in prod, NEVER commit.
PDAX_USERNAME=
PDAX_PASSWORD=
# Base32 TOTP seed — only if the PDAX account has SOFTWARE_TOKEN_MFA.
PDAX_OTP_SECRET=
# Shared secret to validate inbound webhook signatures (optional).
PDAX_WEBHOOK_SECRET=
# Ramp tunables (optional — sensible defaults shown).
PDAX_RAMP_BUFFER_BPS=300
PDAX_RAMP_MIN_PHP=200
PDAX_RAMP_QUOTE_REFERENCE_PHP=1000
# Dev-only escape hatch: accept unsigned webhooks (default false).
PDAX_ALLOW_UNSIGNED_WEBHOOKS=false
# Resilience tunables (optional — sensible defaults shown).
PDAX_MAX_RETRIES=3
PDAX_RATE_LIMIT_PER_SEC=8
PDAX_RATE_LIMIT_BURST=8
